# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,ts,tsx,jsx,json,css,scss,html,yml,yaml,md}]
indent_size = 2

[*.java]
indent_size = 4

[*.xml]
indent_size = 4

[Makefile]
indent_style = tab

[*.{sh,bat,ps1}]
end_of_line = lf
